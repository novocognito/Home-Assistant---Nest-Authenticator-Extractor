{
  "manifest_version": 3,
  "name": "HA Nest Auth Extractor",
  "version": "1.0",
  "description": "Automatically extracts issueToken URL and oauth2/iframe cookies for Home Assistant Nest integration.",
  "permissions": [
    "webRequest",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://accounts.google.com/*",
    "https://home.nest.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nest Tokens"
  }
}